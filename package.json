{
  "name": "md-previewer",
  "version": "1.0.0",
  "description": "Markdown file previewer with folder browsing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore docs/ --ignore .data/ --ignore uploads/ server.js",
    "db:setup": "node scripts/setup-database.js",
    "docs:sync": "node scripts/sync-docs.js"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "connect-pg-simple": "^10.0.0",
    "crypto": "1.0.1",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.18.1",
    "highlight.js": "11.11.1",
    "marked": "15.0.4",
    "marked-highlight": "2.2.1",
    "morgan": "1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.23.1",
    "sanitize-html": "2.13.1",
    "vditor": "4.0.1"
  },
  "devDependencies": {
    "nodemon": "3.1.9"
  }
}

  <dialog id="auth-dialog" aria-labelledby="auth-title">
    <form data-submit="authenticate">
      <div class="dialog-head"><h2 id="auth-title">Masuk kembali</h2><button type="button" class="icon-button" data-action="closeDialog" data-arg="auth-dialog" aria-label="Tutup"><svg><use href="#i-close"/></svg></button></div>
      <div class="dialog-body"><p class="access-description">Sesi sudah berakhir. Masuk kembali untuk melanjutkan; tulisan yang belum disimpan tetap ada di editor.</p><div id="auth-fields"></div></div>
    </form>
  </dialog>

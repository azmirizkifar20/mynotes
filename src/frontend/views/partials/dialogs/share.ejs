  <dialog id="share-dialog" aria-labelledby="share-title" aria-describedby="share-caveat">
    <div class="dialog-head"><h2 id="share-title">Bagikan file</h2><button class="icon-button" data-action="closeDialog" data-arg="share-dialog" aria-label="Tutup pengaturan berbagi"><svg><use href="#i-close"/></svg></button></div>
    <div class="dialog-body">
      <div class="share-file"><svg aria-hidden="true"><use href="#i-doc"/></svg><div><strong id="share-filename"></strong><small id="share-filetype">Dokumen Markdown · akses hanya baca</small></div></div>
      <fieldset class="share-choices" id="share-access"><legend>Akses file</legend><button type="button" data-action="setAccess" data-arg="private" aria-pressed="false"><svg aria-hidden="true"><use href="#i-lock"/></svg><span><strong>Privat</strong><small>Hanya workspace ini</small></span></button><button type="button" data-action="setAccess" data-arg="public" aria-pressed="false"><svg aria-hidden="true"><use href="#i-globe"/></svg><span><strong>Publik</strong><small>Siapa pun dengan link</small></span></button></fieldset>
      <p class="access-description" id="share-description" role="status"></p>
      <label class="share-link-label" for="share-link">Link publik</label><input class="text-input share-link" id="share-link" readonly data-action="selectText">
      <p class="share-caveat" id="share-caveat">Perubahan akses langsung berlaku. Link hanya menampilkan isi yang sudah disimpan.</p>
    </div>
    <div class="dialog-foot"><button class="small-button" data-action="previewPublicAccess">Pratinjau pengunjung</button><button class="small-button primary" id="copy-share" data-action="copyShareLink"><svg><use href="#i-share"/></svg>Salin link</button></div>
  </dialog>

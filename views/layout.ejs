<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>MD Previewer</title>
  <link rel="icon" type="image/svg+xml" sizes="any" href="/static/favicon.svg">
  <script>
    const systemTheme = matchMedia('(prefers-color-scheme: dark)');
    let themePreference = 'system';
    try { const saved = localStorage.getItem('md-previewer-theme'); if(['system','light','dark'].includes(saved)) themePreference = saved; } catch {}
    // Apply before paint so a saved dark preference never flashes the light theme.
    function applyTheme() { document.documentElement.dataset.theme = themePreference === 'system' ? (systemTheme.matches ? 'dark' : 'light') : themePreference; }
    applyTheme();
    systemTheme.addEventListener('change', applyTheme);
  </script>
  <link rel="preload" href="/static/fonts/inter-variable.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <svg class="icon-defs" xmlns="http://www.w3.org/2000/svg"><defs>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10H3Z M9 20v-7h6v7"/></symbol>
    <symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6Z M14 3v5h4 M9 12h6 M9 16h6"/></symbol>
    <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7V5h7l2 3h9v12H3V7Z"/></symbol>
    <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14 M5 12h14"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    <symbol id="i-star" viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z"/></symbol>
    <symbol id="i-upload" viewBox="0 0 24 24"><path d="M4 15v6h16v-6 M12 16V3 m-5 5 5-5 5 5"/></symbol>
    <symbol id="i-book" viewBox="0 0 24 24"><path d="M5 3h14v18H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z M7 3v18 M11 8h5 M11 11h4 M3 17h4"/></symbol>
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
    <symbol id="i-list" viewBox="0 0 24 24"><path d="M8 6h13 M8 12h13 M8 18h13 M3 6h.1 M3 12h.1 M3 18h.1"/></symbol>
    <symbol id="i-panel" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12 M6 18 18 6"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4 M12 15v2"/></symbol>
    <symbol id="i-expand" viewBox="0 0 24 24"><path d="M8 3H3v5 M16 3h5v5 M3 16v5h5 M21 16v5h-5"/></symbol>
    <symbol id="i-code" viewBox="0 0 24 24"><path d="m7 7-5 5 5 5 m10-10 5 5-5 5 M14 4l-4 16"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
    <symbol id="i-theme" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none"/></symbol>
    <symbol id="i-share" viewBox="0 0 24 24"><path d="M8 12 16 7 M8 12l8 5"/><circle cx="5" cy="12" r="3"/><circle cx="19" cy="5" r="3"/><circle cx="19" cy="19" r="3"/></symbol>
    <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></symbol>
    <symbol id="i-more" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></symbol>
    <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18 M9 6V3h6v3 M5 6l1 15h12l1-15 M10 10v7 M14 10v7"/></symbol>
  </defs></svg>
  <div id="access-page" class="access-page" hidden></div>
  <div class="app" id="workspace-app" hidden>
    <button class="scrim" aria-label="Tutup navigasi" onclick="closeSidebar()"></button>
    <aside class="sidebar" aria-label="Navigasi workspace">
      <div class="brand"><span class="brand-mark" aria-hidden="true">m.</span><div>MD Previewer<small>Personal workspace</small></div><button class="icon-button collapse" onclick="toggleSidebar()" aria-label="Sembunyikan sidebar" title="Sembunyikan sidebar"><svg><use href="#i-panel"/></svg></button></div>
      <div class="sidebar-scroll">
      <button class="nav-item" onclick="openSearch()"><svg><use href="#i-search"/></svg><span>Cari catatan</span><kbd>Ctrl K</kbd></button>
      <button class="nav-item active" data-nav="home" onclick="navigate('home')"><svg><use href="#i-home"/></svg><span>Ruang kerja</span></button>
      <button class="nav-item" data-nav="recent" onclick="navigate('recent')"><svg><use href="#i-clock"/></svg><span>Terakhir dibuka</span></button>
      <div class="nav-section"><div class="section-label">Favorit</div><div id="favorites"></div></div>
      <nav class="nav-section" aria-label="Folder dokumen">
        <div class="section-label">Workspace <span>docs /</span></div>
        <div id="folder-tree"></div>
        <button class="nav-item" onclick="openCreate('folder')"><svg><use href="#i-plus"/></svg><span>Tambah folder</span></button>
      </nav>
      <div class="sidebar-bottom"><button class="nav-item" onclick="document.getElementById('upload-input').click()"><svg><use href="#i-upload"/></svg><span>Import Markdown</span></button><button class="nav-item" onclick="logout()"><svg><use href="#i-lock"/></svg><span>Keluar</span></button></div>
      </div>
      <label class="theme-setting" for="theme-select"><svg aria-hidden="true"><use href="#i-theme"/></svg><span>Tampilan</span><select id="theme-select" onchange="setTheme(this.value)"><option value="system">Sistem</option><option value="light">Terang</option><option value="dark">Gelap</option></select></label>
    </aside>
    <div class="workspace">
      <header class="topbar">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><button class="icon-button sidebar-toggle" onclick="toggleSidebar()" aria-label="Buka navigasi"><svg><use href="#i-panel"/></svg></button><ol class="breadcrumb-path" id="breadcrumb-path"></ol></nav>
        <div class="top-actions"><span class="save-state" id="save-state">Workspace pribadi</span><button class="small-button detail-share" id="detail-share" onclick="openShare(current)" aria-label="Bagikan file" title="Bagikan file" hidden><svg><use href="#i-share"/></svg><span>Bagikan</span></button><button class="icon-button" id="favorite-button" onclick="toggleFavorite()" aria-label="Tambah ke favorit" title="Tambah ke favorit"><svg><use href="#i-star"/></svg></button><button class="icon-button" id="manage-button" onclick="openManage(current)" aria-label="Kelola halaman atau folder" title="Kelola halaman atau folder"><svg><use href="#i-more"/></svg></button><button class="icon-button" onclick="toggleWidth()" aria-label="Ganti lebar halaman" title="Ganti lebar halaman" aria-pressed="false" id="width-button"><svg><use href="#i-expand"/></svg></button></div>
      </header>
      <div class="page-layout"><main id="main" tabindex="-1"></main><aside class="outline" aria-label="Daftar isi" id="outline"></aside></div>
    </div>
  </div>
  <dialog id="search-dialog" aria-label="Cari catatan"><div class="search-line"><svg><use href="#i-search"/></svg><input id="search-input" placeholder="Cari judul catatan atau folder…" aria-label="Cari judul catatan atau folder" autocomplete="off"><button class="icon-button" onclick="document.getElementById('search-dialog').close()" aria-label="Tutup pencarian"><svg><use href="#i-close"/></svg></button></div><div class="search-results" id="search-results"></div><div class="search-foot">Cari di seluruh workspace. Escape untuk menutup.</div></dialog>
  <dialog id="create-dialog" aria-labelledby="create-title"><form id="create-form"><div class="dialog-head"><h2 id="create-title">Halaman baru</h2><button type="button" class="icon-button" onclick="document.getElementById('create-dialog').close()" aria-label="Tutup"><svg><use href="#i-close"/></svg></button></div><div class="dialog-body"><label class="field-label" for="new-name" id="name-label">Judul halaman</label><input class="text-input" id="new-name" required maxlength="100" autocomplete="off"><p class="edit-hint">Tersimpan di folder yang sedang dibuka.</p></div><div class="dialog-foot"><button type="button" class="small-button" onclick="document.getElementById('create-dialog').close()">Batal</button><button class="small-button primary" type="submit">Buat</button></div></form></dialog>
  <dialog id="share-dialog" aria-labelledby="share-title" aria-describedby="share-caveat">
    <div class="dialog-head"><h2 id="share-title">Bagikan file</h2><button class="icon-button" onclick="document.getElementById('share-dialog').close()" aria-label="Tutup pengaturan berbagi"><svg><use href="#i-close"/></svg></button></div>
    <div class="dialog-body">
      <div class="share-file"><svg aria-hidden="true"><use href="#i-doc"/></svg><div><strong id="share-filename"></strong><small>Dokumen Markdown · akses hanya baca</small></div></div>
      <div class="access-setting"><label for="share-access">Akses file</label><select id="share-access" onchange="setAccess(this.value)"><option value="public">Publik</option><option value="private">Privat</option></select></div>
      <p class="access-description" id="share-description" role="status"></p>
      <label class="share-link-label" for="share-link">Link publik</label><input class="text-input share-link" id="share-link" readonly onclick="this.select()">
      <p class="share-caveat" id="share-caveat">Perubahan akses langsung berlaku. Link hanya menampilkan isi yang sudah disimpan.</p>
    </div>
    <div class="dialog-foot"><button class="small-button" onclick="previewPublicAccess()">Pratinjau pengunjung</button><button class="small-button primary" id="copy-share" onclick="copyShareLink()"><svg><use href="#i-share"/></svg>Salin link</button></div>
  </dialog>
  <dialog id="visitor-dialog" aria-labelledby="visitor-title"><div class="dialog-head"><h2 id="visitor-title">Pratinjau pengunjung</h2><button class="icon-button" onclick="document.getElementById('visitor-dialog').close()" aria-label="Tutup pratinjau pengunjung"><svg><use href="#i-close"/></svg></button></div><div class="visitor-page" id="visitor-content"></div><div class="dialog-foot"><button class="small-button" onclick="document.getElementById('visitor-dialog').close();openShare(sharingId)">Kembali ke pengaturan</button></div></dialog>
  <dialog id="manage-dialog" aria-labelledby="manage-title">
    <form onsubmit="renameItem(event)">
      <div class="dialog-head"><h2 id="manage-title">Kelola halaman</h2><button type="button" class="icon-button" onclick="document.getElementById('manage-dialog').close()" aria-label="Tutup"><svg><use href="#i-close"/></svg></button></div>
      <div class="dialog-body"><label class="field-label" for="rename-name">Nama</label><input class="text-input" id="rename-name" required maxlength="100" autocomplete="off"><p class="edit-hint">Link berbagi dan pengaturan akses tetap tersimpan saat nama berubah.</p></div>
      <div class="dialog-foot"><button type="button" class="small-button danger" id="delete-item" onclick="deleteItem()">Hapus</button><button type="button" class="small-button" onclick="document.getElementById('manage-dialog').close()">Batal</button><button type="submit" class="small-button primary">Simpan nama</button></div>
    </form>
  </dialog>
  <dialog id="delete-dialog" aria-labelledby="delete-title" aria-describedby="delete-description delete-draft" oncancel="if(saving) event.preventDefault()" onclose="deletion = null">
    <form id="delete-form" onsubmit="confirmDelete(event)" aria-busy="false">
      <div class="dialog-head"><h2 id="delete-title">Hapus file?</h2><button type="button" class="icon-button" onclick="closeDeleteDialog()" aria-label="Tutup konfirmasi hapus"><svg aria-hidden="true"><use href="#i-close"/></svg></button></div>
      <div class="dialog-body">
        <p id="delete-description">Item ini akan dihapus permanen.</p>
        <div class="delete-target"><svg aria-hidden="true"><use href="#i-trash"/></svg><div><strong id="delete-filename"></strong><small id="delete-path"></small></div></div>
        <p class="delete-warning" id="delete-draft" hidden>Perubahan yang belum disimpan di editor juga akan dibuang.</p>
        <p class="delete-warning">Tindakan ini tidak dapat dibatalkan.</p>
        <p class="delete-error" id="delete-error" role="alert"></p>
      </div>
      <div class="dialog-foot"><button type="button" class="small-button" id="cancel-delete" onclick="closeDeleteDialog()" autofocus>Batal</button><button type="submit" class="small-button destructive" id="confirm-delete">Hapus file</button></div>
    </form>
  </dialog>
  <div id="file-drop-zone" class="file-drop-zone" role="status" hidden><div class="file-drop-card"><svg aria-hidden="true"><use href="#i-upload"/></svg><strong>Lepaskan file .md di sini</strong><span id="file-drop-target"></span><small>Satu file, maksimal 5 MB. Tinjau file sebelum upload.</small></div></div>
  <dialog id="upload-dialog" aria-labelledby="upload-title" aria-describedby="upload-description upload-draft" oncancel="if(saving) event.preventDefault()" onclose="pendingUpload = null">
    <form id="upload-form" onsubmit="confirmUpload(event)" aria-busy="false">
      <div class="dialog-head"><h2 id="upload-title">Tinjau file sebelum upload</h2><button type="button" class="icon-button" onclick="closeUploadDialog()" aria-label="Tutup pratinjau upload"><svg aria-hidden="true"><use href="#i-close"/></svg></button></div>
      <div class="dialog-body">
        <p id="upload-description" class="upload-description">Periksa nama dan isi file. File baru akan disimpan sebagai privat setelah kamu klik Upload.</p>
        <div class="upload-meta"><span>Folder tujuan</span><strong id="upload-target"></strong><small id="upload-size"></small></div>
        <label class="field-label" for="upload-name">Nama file</label><input class="text-input" id="upload-name" required autocomplete="off" spellcheck="false" aria-describedby="upload-name-hint"><p class="edit-hint" id="upload-name-hint">Gunakan ekstensi .md. File dengan nama yang sama tidak akan ditimpa.</p>
        <label class="field-label" for="upload-content">Isi file</label><textarea id="upload-content" class="upload-content" readonly spellcheck="false" aria-describedby="upload-status"></textarea><p id="upload-status" class="edit-hint" role="status"></p>
        <p id="upload-draft" class="delete-warning" hidden>Setelah upload berhasil, kamu akan kembali ke folder tujuan. Perubahan dokumen yang belum disimpan akan dibuang. Pilih Batal untuk menyimpannya terlebih dahulu.</p>
        <p id="upload-error" class="delete-error" role="alert"></p>
      </div>
      <div class="dialog-foot"><button type="button" class="small-button" onclick="closeUploadDialog()">Batal</button><button id="confirm-upload" class="small-button primary" type="submit">Upload</button></div>
    </form>
  </dialog>
  <dialog id="auth-dialog" aria-labelledby="auth-title">
    <form onsubmit="authenticate(event)">
      <div class="dialog-head"><h2 id="auth-title">Masuk kembali</h2><button type="button" class="icon-button" onclick="document.getElementById('auth-dialog').close()" aria-label="Tutup"><svg><use href="#i-close"/></svg></button></div>
      <div class="dialog-body"><p class="access-description">Sesi sudah berakhir. Masuk kembali untuk melanjutkan; tulisan yang belum disimpan tetap ada di editor.</p><div id="auth-fields"></div></div>
    </form>
  </dialog>
  <input id="upload-input" type="file" accept=".md,.markdown,text/markdown,text/plain" hidden>
  <div class="toast" id="toast" role="status" hidden></div>
  <script id="bootstrap" type="application/json"><%- bootstrap %></script>
  <script src="/static/app.js" defer></script>
  <noscript><p class="empty">Aktifkan JavaScript untuk membuka MD Previewer.</p></noscript>
</body>
</html>
